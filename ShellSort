#include <stdio.h>
void shellSort(int a[], int n)
{
    int gap, i, j, temp;
    /* Start with a large gap */
    for (gap = n / 2; gap > 0; gap = gap / 2)
    {
        /* Perform insertion sort with the given gap */
        for (i = gap; i < n; i++)
        {
            temp = a[i];
            j = i;
            /* Shift elements that are greater than temp */
            while (j >= gap && a[j - gap] > temp)
            {
                a[j] = a[j - gap];
                j = j - gap;
            }
            /* Insert temp in its correct position */
            a[j] = temp;
        }
    }
}
int main()
{
    int a[20], n, i;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    printf("Enter elements:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }
    shellSort(a, n);
    printf("Sorted array:\n");
    for (i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }
    return 0;
}
