#include<stdio.h>
#define max 100
int arr[max];
void radixSort(int arr[], int n);
int main() {
    int n, i;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    printf("Enter elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    printf("Original array:\n");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);
    radixSort(arr, n);
    printf("Sorted array:\n");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);
    return 0;
}
void radixSort(int arr[], int n) {
    int Max = arr[0], steps,k,i,nod,noe[10],bucket[10][max],loc,div=1;
    for (i = 1; i < n; i++)
        if (arr[i] > Max)
            Max = arr[i];
    while(Max>0){
        Max=Max/10;
        nod++;
    }
    for (steps = 1; steps <= nod; steps++) {
        for (i = 0; i < 10; i++)
            noe[i] = 0;
        for (i = 0; i < n; i++) {
            loc = (arr[i] / div) % 10;
            bucket[loc][noe[loc]] = arr[i];
            noe[loc]++;
        }
        div *= 10;
        k = 0;
        for (i = 0; i < 10; i++) {
            for (int j = 0; j < noe[i]; j++) {
                arr[k++] = bucket[i][j];
            }
        }
    }
}
