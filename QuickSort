#include<stdio.h>
#include<stdlib.h>
#define max 100
int arr[max];
int sort[max];
void quicksort(int,int);
int partition(int[],int,int);
int main(){
    int n,i;
    printf("Enter number of elements\n");
    scanf("%d",&n);
    printf("Enter the elements\n");
    for(i=0;i<n;i++)        
     scanf("%d",&arr[i]);
    printf("The elements before sorting are\n");
    for(i=0;i<n;i++)
     printf("%d ",arr[i]);
    printf("\n");
    quicksort(0,n-1);
    printf("The elements after sorting are\n");
    for(i=0;i<n;i++)   
     printf("%d ",arr[i]); 
    return 0;
}
void quicksort(int low,int high){
    int j;
    if(low<high){
        j=partition(arr,low,high);
        quicksort(low,j-1);
        quicksort(j+1,high);
    }
}
int partition(int arr[],int low,int high){
    int v,i,j,temp;
    v=arr[low];
    i=low;
    j=high;
    do{
        do{i++;}while(v<arr[i]);
        do{j--;}while(v>arr[j]);
        if(i<j){
            temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
        }
    }while(i<j);
    arr[low]=arr[j];
    arr[j]=v; 
    return j;
}
